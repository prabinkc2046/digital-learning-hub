  <script>
    const PROGRESS_STORAGE_KEY = "mac-classroom-readiness-progress-v1";
    const SECTIONS_STORAGE_KEY = "mac-classroom-readiness-sections-v1";

    const checkboxes = [
      ...document.querySelectorAll('input[type="checkbox"][data-id]')
    ];

    const sections = [
      ...document.querySelectorAll("details[data-section]")
    ];

    const progressText = document.getElementById("progressText");
    const progressBar = document.getElementById("progressBar");
    const progressTrack = document.getElementById("progressTrack");
    const completionMessage = document.getElementById("completionMessage");
    const resetButton = document.getElementById("resetButton");
    const expandAllButton = document.getElementById("expandAll");
    const collapseAllButton = document.getElementById("collapseAll");

    function readStorage(key) {
      try {
        return JSON.parse(localStorage.getItem(key)) || {};
      } catch {
        return {};
      }
    }

    function loadProgress() {
      const savedProgress = readStorage(PROGRESS_STORAGE_KEY);

      checkboxes.forEach((checkbox) => {
        checkbox.checked = savedProgress[checkbox.dataset.id] === true;
      });
    }

    function saveProgress() {
      const progress = {};

      checkboxes.forEach((checkbox) => {
        progress[checkbox.dataset.id] = checkbox.checked;
      });

      localStorage.setItem(
        PROGRESS_STORAGE_KEY,
        JSON.stringify(progress)
      );

      updateProgress();
    }

    function updateProgress() {
      const total = checkboxes.length;
      const completed = checkboxes.filter(
        (checkbox) => checkbox.checked
      ).length;

      const percentage = total
        ? Math.round((completed / total) * 100)
        : 0;

      progressText.textContent =
        `${completed} of ${total} tasks completed · ${percentage}%`;

      progressBar.style.width = `${percentage}%`;

      progressTrack.setAttribute(
        "aria-valuenow",
        String(percentage)
      );

      completionMessage.classList.toggle(
        "visible",
        total > 0 && completed === total
      );

      updateSectionProgress();
    }

    function updateSectionProgress() {
      sections.forEach((section) => {
        const sectionCheckboxes = [
          ...section.querySelectorAll('input[type="checkbox"]')
        ];

        const completed = sectionCheckboxes.filter(
          (checkbox) => checkbox.checked
        ).length;

        const total = sectionCheckboxes.length;

        const sectionProgress =
          section.querySelector(".section-progress");

        sectionProgress.textContent =
          `${completed} of ${total} completed`;

        if (total > 0 && completed === total) {
          sectionProgress.textContent =
            `Completed · ${completed} of ${total}`;
        }
      });
    }

    function loadSectionStates() {
      const savedSections = readStorage(SECTIONS_STORAGE_KEY);

      sections.forEach((section) => {
        const sectionId = section.dataset.section;

        if (Object.prototype.hasOwnProperty.call(savedSections, sectionId)) {
          section.open = savedSections[sectionId];
        }
      });
    }

    function saveSectionStates() {
      const sectionStates = {};

      sections.forEach((section) => {
        sectionStates[section.dataset.section] = section.open;
      });

      localStorage.setItem(
        SECTIONS_STORAGE_KEY,
        JSON.stringify(sectionStates)
      );
    }

    checkboxes.forEach((checkbox) => {
      checkbox.addEventListener("change", saveProgress);
    });

    sections.forEach((section) => {
      section.addEventListener("toggle", saveSectionStates);
    });

    expandAllButton.addEventListener("click", () => {
      sections.forEach((section) => {
        section.open = true;
      });

      saveSectionStates();
    });

    collapseAllButton.addEventListener("click", () => {
      sections.forEach((section) => {
        section.open = false;
      });

      saveSectionStates();
    });

    resetButton.addEventListener("click", () => {
      const shouldReset = window.confirm(
        "Reset all checklist progress? This cannot be undone."
      );

      if (!shouldReset) {
        return;
      }

      checkboxes.forEach((checkbox) => {
        checkbox.checked = false;
      });

      localStorage.removeItem(PROGRESS_STORAGE_KEY);
      updateProgress();
    });

    loadProgress();
    loadSectionStates();
    updateProgress();
  </script>

